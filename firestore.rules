rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper functions for entity validation
    function isValidUserProfile(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.preferredLanguage is string && data.preferredLanguage.size() <= 50 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.timezone is string && data.timezone.size() <= 50 &&
             data.onboardingCompleted is bool &&
             (!('preferredTheme' in data) || data.preferredTheme is string) &&
             (!('wakeTime' in data) || data.wakeTime is string) &&
             (!('sleepTime' in data) || data.sleepTime is string) &&
             (!('workSchedule' in data) || data.workSchedule is string) &&
             (!('studyTime' in data) || data.studyTime is string) &&
             (!('breakTimes' in data) || data.breakTimes is string) &&
             (!('weeklyRestDay' in data) || data.weeklyRestDay is string);
    }

    function isValidTask(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 50 &&
             data.priority is string && data.priority.size() <= 20 &&
             data.isCompleted is bool &&
             (!('description' in data) || data.description is string) &&
             (!('dueDate' in data) || data.dueDate is string) &&
             (!('startTime' in data) || data.startTime is string) &&
             (!('endTime' in data) || data.endTime is string) &&
             (!('estimatedDuration' in data) || data.estimatedDuration is string) &&
             (!('recurrence' in data) || data.recurrence is string) &&
             (!('relatedGoalId' in data) || data.relatedGoalId is string);
    }

    function isValidSubject(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.isActive is bool &&
             (!('description' in data) || data.description is string) &&
             (!('targetDate' in data) || data.targetDate is string) &&
             (!('weeklyStudyTargetMinutes' in data) || data.weeklyStudyTargetMinutes is int);
    }

    function isValidTopic(data) {
      return data.subjectId is string && data.subjectId.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.status is string && data.status.size() <= 30 &&
             data.priority is string && data.priority.size() <= 20 &&
             (!('description' in data) || data.description is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('revisionDate' in data) || data.revisionDate is string) &&
             (!('estimatedMinutes' in data) || data.estimatedMinutes is int) &&
             (!('actualMinutes' in data) || data.actualMinutes is int) &&
             (!('quizScore' in data) || data.quizScore is int);
    }

    function isValidSession(data) {
      return data.subjectId is string && data.subjectId.size() > 0 &&
             data.date is string && data.date.size() > 0 &&
             data.durationMinutes is int && data.durationMinutes >= 0 &&
             (!('topicId' in data) || data.topicId is string) &&
             (!('subjectName' in data) || data.subjectName is string) &&
             (!('topicName' in data) || data.topicName is string) &&
             (!('studyMethod' in data) || data.studyMethod is string) &&
             (!('notes' in data) || data.notes is string) &&
             (!('score' in data) || data.score is int);
    }

    function isValidAccount(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.accountType is string && data.accountType.size() <= 50 &&
             (data.openingBalance is number || data.openingBalance is int) &&
             (data.currentBalance is number || data.currentBalance is int);
    }

    function isValidTransaction(data) {
      return data.type is string && data.type.size() <= 20 &&
             (data.amount is number || data.amount is int) && data.amount >= 0 &&
             data.category is string && data.category.size() <= 50 &&
             data.date is string && data.date.size() > 0 &&
             (!('accountId' in data) || data.accountId is string) &&
             (!('toAccountId' in data) || data.toAccountId is string) &&
             (!('paymentMethod' in data) || data.paymentMethod is string) &&
             (!('description' in data) || data.description is string) &&
             (!('tags' in data) || data.tags is list);
    }

    function isValidBudget(data) {
      return (data.monthlyExpenseBudget is number || data.monthlyExpenseBudget is int) &&
             (data.monthlySavingsTarget is number || data.monthlySavingsTarget is int) &&
             data.monthYear is string && data.monthYear.size() > 0 &&
             (!('categoryBudgets' in data) || data.categoryBudgets is string);
    }

    function isValidGoal(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 50 &&
             data.isCompleted is bool &&
             (!('description' in data) || data.description is string) &&
             (!('targetAmount' in data) || data.targetAmount is number || data.targetAmount is int) &&
             (!('currentAmount' in data) || data.currentAmount is number || data.currentAmount is int) &&
             (!('targetDate' in data) || data.targetDate is string) &&
             (!('progressPercent' in data) || data.progressPercent is int) &&
             (!('notes' in data) || data.notes is string) &&
             (!('milestones' in data) || data.milestones is list);
    }

    function isValidChatMessage(data) {
      return data.role is string && (data.role == 'user' || data.role == 'model') &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 50000 &&
             data.timestamp is int;
    }

    // Rules for /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isOwner(userId);

      // Tasks
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(taskId) &&
                         isValidTask(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Subjects
      match /subjects/{subjectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         isValidSubject(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(subjectId) &&
                         isValidSubject(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Topics
      match /topics/{topicId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(topicId) &&
                         isValidTopic(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(topicId) &&
                         isValidTopic(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Study Sessions
      match /study_sessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidSession(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(sessionId) &&
                         isValidSession(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Accounts
      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(accountId) &&
                         isValidAccount(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(accountId) &&
                         isValidAccount(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Transactions
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(transactionId) &&
                         isValidTransaction(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Budgets
      match /budgets/{budgetId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(budgetId) &&
                         isValidBudget(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(budgetId) &&
                         isValidBudget(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // Goals
      match /goals/{goalId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(goalId) &&
                         isValidGoal(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(goalId) &&
                         isValidGoal(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }

      // AI Chat Messages
      match /chat_messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidId(messageId) &&
                         isValidChatMessage(incoming()) &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
